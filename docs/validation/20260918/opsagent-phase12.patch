+++ b/ops-auth-service/src/main/java/com/opsagent/auth/HarnessIdentityService.java
@@ -0,0 +1,349 @@
+package com.opsagent.auth;
+
+import com.fasterxml.jackson.core.type.TypeReference;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.opsagent.common.core.BusinessException;
+import com.opsagent.common.core.ErrorCode;
+import com.opsagent.common.security.InternalActorTokens;
+import com.opsagent.common.security.JwtService;
+import com.opsagent.common.security.OpsPrincipal;
+
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.boot.autoconfigure.condition.ConditionalOnProperty;
+import org.springframework.dao.DuplicateKeyException;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.stereotype.Service;
+
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.time.Instant;
+import java.util.HexFormat;
+import java.util.List;
+import java.util.Set;
+import java.util.UUID;
+
+/**
+ * Existing OpsAgent identities delegated to explicitly granted Harness applications. Raw login
+ * tokens and application credentials are never stored in delegation records.
+ *
+ * @author heyu
+ * @since 2026/9/3
+ */
+@Service
+@ConditionalOnProperty(name = "ops.harness.identity.enabled", havingValue = "true")
+public class HarnessIdentityService {
+    private static final ObjectMapper JSON = new ObjectMapper();
+    private static final Set<String> PERMISSIONS =
+            Set.of(
+                    "runs:create",
+                    "runs:read",
+                    "runs:list",
+                    "runs:events:read",
+                    "runs:control",
+                    "runs:output:read",
+                    "runs:admin",
+                    "approvals:read",
+                    "approvals:decide",
+                    "approvals:review",
+                    "runs:reconcile:read",
+                    "runs:reconcile",
+                    "opsagent:rag:search",
+                    "model:invoke");
+    private final JdbcTemplate jdbc;
+    private final AuthService auth;
+    private final JwtService jwt;
+    private final InternalActorTokens tokens;
+
+    public HarnessIdentityService(
+            JdbcTemplate jdbc,
+            AuthService auth,
+            JwtService jwt,
+            @Value("${ops.agent.internal-secret:${OPS_AGENT_INTERNAL_SECRET:}}") String secret) {
+        this.jdbc = jdbc;
+        this.auth = auth;
+        this.jwt = jwt;
+        this.tokens = new InternalActorTokens(secret);
+    }
+
+    public IdentityView introspect(
+            String applicationAuthorization, String projectId, String userToken) {
+        String application = application(applicationAuthorization);
+        OpsPrincipal principal = login(userToken);
+        return identity(application, projectId, principal.userId(), principal.roles());
+    }
+
+    public DelegationView delegate(
+            String applicationAuthorization,
+            String projectId,
+            String userToken,
+            String runId,
+            Instant deadline) {
+        String application = application(applicationAuthorization);
+        OpsPrincipal principal = login(userToken);
+        IdentityView identity =
+                identity(application, projectId, principal.userId(), principal.roles());
+        if (runId == null
+                || !runId.matches("[A-Za-z0-9._:-]{1,128}")
+                || deadline == null
+                || !deadline.isAfter(Instant.now())
+                || deadline.isAfter(Instant.now().plusSeconds(86400))) {
+            throw denied(ErrorCode.VALIDATION, "HARNESS_DELEGATION_INVALID");
+        }
+        // Freeze only current roles covered by the authenticated login token.
+        List<String> ceiling = currentRoles(principal.userId(), principal.roles());
+        String id = UUID.randomUUID().toString();
+        long until = deadline.getEpochSecond();
+        try {
+            jdbc.update(
+                    "INSERT INTO ops_harness_delegation"
+                        + " (id,application_id,project_id,user_id,run_id,roles_json,"
+                        + "permissions_json,expires_at,revoked)"
+                        + " VALUES(?,?,?,?,?,?,?,?,0)",
+                    id,
+                    application,
+                    projectId,
+                    principal.userId(),
+                    runId,
+                    json(ceiling),
+                    json(identity.permissions()),
+                    until);
+        } catch (DuplicateKeyException conflict) {
+            Delegation existing = byRun(application, runId);
+            if (!existing.project().equals(projectId)
+                    || existing.user() != principal.userId()
+                    || existing.expiresAt() != until) {
+                throw denied(ErrorCode.CONFLICT, "HARNESS_DELEGATION_CONFLICT");
+            }
+            identity = identityFor(existing);
+            return new DelegationView(
+                    existing.id(),
+                    Instant.ofEpochSecond(existing.expiresAt()).toString(),
+                    identity);
+        }
+        return new DelegationView(id, Instant.ofEpochSecond(until).toString(), identity);
+    }
+
+    public IdentityView current(
+            String applicationAuthorization, String delegationId, String runId) {
+        return identityFor(delegation(applicationAuthorization, delegationId, runId));
+    }
+
+    public TokenView token(
+            String applicationAuthorization, String delegationId, String runId, String audience) {
+        if (!"rag".equals(audience)) throw denied(ErrorCode.FORBIDDEN, "HARNESS_AUDIENCE_DENIED");
+        Delegation delegation = delegation(applicationAuthorization, delegationId, runId);
+        IdentityView identity = identityFor(delegation);
+        if (!identity.permissions().contains("opsagent:rag:search")) {
+            throw denied(ErrorCode.FORBIDDEN, "HARNESS_RETRIEVAL_DENIED");
+        }
+        AuthService.ActorView actor = auth.actor(delegation.user());
+        List<String> roles = currentRoles(delegation.user(), strings(delegation.roles()));
+        Instant deadline = Instant.ofEpochSecond(delegation.expiresAt());
+        if (actor.expiresAt() != null && actor.expiresAt().isBefore(deadline))
+            deadline = actor.expiresAt();
+        String authorization =
+                "Bearer "
+                        + tokens.issue(
+                                "rag",
+                                new InternalActorTokens.Context(
+                                        actor.userId(),
+                                        actor.username(),
+                                        roles,
+                                        runId,
+                                        "",
+                                        deadline));
+        Instant expiry =
+                deadline.isBefore(Instant.now().plusSeconds(120))
+                        ? deadline
+                        : Instant.now().plusSeconds(120);
+        return new TokenView(authorization, expiry.toString());
+    }
+
+    private IdentityView identityFor(Delegation delegation) {
+        if (delegation.revoked() || delegation.expiresAt() <= Instant.now().getEpochSecond()) {
+            throw denied(ErrorCode.FORBIDDEN, "HARNESS_DELEGATION_EXPIRED_OR_REVOKED");
+        }
+        IdentityView current =
+                identity(
+                        delegation.application(),
+                        delegation.project(),
+                        delegation.user(),
+                        strings(delegation.roles()));
+        List<String> ceiling = strings(delegation.permissions());
+        return new IdentityView(
+                current.applicationId(),
+                current.projectId(),
+                current.subject(),
+                current.permissions().stream().filter(ceiling::contains).toList());
+    }
+
+    private Delegation delegation(String authorization, String id, String runId) {
+        String app = application(authorization);
+        if (id == null || !id.matches("[a-f0-9-]{36}") || runId == null) {
+            throw denied(ErrorCode.NOT_FOUND, "HARNESS_DELEGATION_NOT_FOUND");
+        }
+        List<Delegation> rows =
+                jdbc.query(
+                        "SELECT * FROM ops_harness_delegation"
+                                + " WHERE id=? AND application_id=? AND run_id=?",
+                        HarnessIdentityService::row,
+                        id,
+                        app,
+                        runId);
+        if (rows.size() != 1) throw denied(ErrorCode.NOT_FOUND, "HARNESS_DELEGATION_NOT_FOUND");
+        return rows.get(0);
+    }
+
+    private Delegation byRun(String app, String runId) {
+        List<Delegation> rows =
+                jdbc.query(
+                        "SELECT * FROM ops_harness_delegation"
+                                + " WHERE application_id=? AND run_id=?",
+                        HarnessIdentityService::row,
+                        app,
+                        runId);
+        if (rows.size() != 1) throw denied(ErrorCode.CONFLICT, "HARNESS_DELEGATION_CONFLICT");
+        return rows.get(0);
+    }
+
+    private static Delegation row(java.sql.ResultSet rs, int index) throws java.sql.SQLException {
+        return new Delegation(
+                rs.getString("id"),
+                rs.getString("application_id"),
+                rs.getString("project_id"),
+                rs.getLong("user_id"),
+                rs.getString("run_id"),
+                rs.getString("roles_json"),
+                rs.getString("permissions_json"),
+                rs.getLong("expires_at"),
+                rs.getBoolean("revoked"));
+    }
+
+    private String application(String authorization) {
+        if (authorization == null || !authorization.matches("Bearer [A-Za-z0-9._~+/=-]{32,512}")) {
+            throw denied(ErrorCode.UNAUTHENTICATED, "HARNESS_APPLICATION_REQUIRED");
+        }
+        List<String> apps =
+                jdbc.query(
+                        "SELECT application_id FROM ops_harness_application"
+                                + " WHERE credential_hash=? AND enabled=1",
+                        (rs, row) -> rs.getString(1),
+                        sha256(authorization.substring(7)));
+        if (apps.size() != 1)
+            throw denied(ErrorCode.UNAUTHENTICATED, "HARNESS_APPLICATION_INVALID");
+        return apps.get(0);
+    }
+
+    private OpsPrincipal login(String token) {
+        if (token == null || token.length() > 10000) {
+            throw denied(ErrorCode.UNAUTHENTICATED, "HARNESS_USER_TOKEN_INVALID");
+        }
+        try {
+            return jwt.parse(token);
+        } catch (RuntimeException invalid) {
+            throw denied(ErrorCode.UNAUTHENTICATED, "HARNESS_USER_TOKEN_INVALID");
+        }
+    }
+
+    private IdentityView identity(String app, String project, long user, List<String> ceiling) {
+        if (project == null || !project.matches("[A-Za-z0-9][A-Za-z0-9._-]{0,63}")) {
+            throw denied(ErrorCode.FORBIDDEN, "HARNESS_PROJECT_DENIED");
+        }
+        List<String> roles = currentRoles(user, ceiling);
+        List<Grant> grants =
+                jdbc.query(
+                        "SELECT required_role,permissions_json FROM ops_harness_grant WHERE"
+                                + " application_id=? AND project_id=? AND user_id=? AND enabled=1",
+                        (rs, row) -> new Grant(rs.getString(1), rs.getString(2)),
+                        app,
+                        project,
+                        user);
+        if (grants.size() != 1 || !roles.contains(grants.get(0).role())) {
+            throw denied(ErrorCode.FORBIDDEN, "HARNESS_GRANT_DENIED");
+        }
+        List<String> permissions = strings(grants.get(0).permissions());
+        if (permissions.isEmpty() || permissions.stream().anyMatch(permission ->
+                !PERMISSIONS.contains(permission)
+                        && !permission.matches("tool:[A-Za-z0-9][A-Za-z0-9._:/-]{0,199}"))) {
+            throw denied(ErrorCode.FORBIDDEN, "HARNESS_GRANT_INVALID");
+        }
+        return new IdentityView(app, project, Long.toString(user), permissions);
+    }
+
+    private List<String> currentRoles(long userId, List<String> ceiling) {
+        AuthService.ActorView current = auth.actor(userId);
+        if (!current.active() || current.revokedAt() != null) {
+            throw denied(ErrorCode.FORBIDDEN, "HARNESS_ACTOR_DISABLED");
+        }
+        List<String> roles =
+                current.roles().stream().filter(ceiling::contains).distinct().sorted().toList();
+        if (roles.isEmpty()) throw denied(ErrorCode.FORBIDDEN, "HARNESS_ROLES_REVOKED");
+        return roles;
+    }
+
+    private static List<String> strings(String json) {
+        try {
+            return List.copyOf(JSON.readValue(json, new TypeReference<List<String>>() {}));
+        } catch (Exception failure) {
+            throw denied(ErrorCode.FORBIDDEN, "HARNESS_GRANT_INVALID");
+        }
+    }
+
+    private static String json(Object value) {
+        try {
+            return JSON.writeValueAsString(value);
+        } catch (Exception failure) {
+            throw new IllegalArgumentException("HARNESS_IDENTITY_INVALID");
+        }
+    }
+
+    public static String sha256(String value) {
+        try {
+            return HexFormat.of()
+                    .formatHex(
+                            MessageDigest.getInstance("SHA-256")
+                                    .digest(value.getBytes(StandardCharsets.UTF_8)));
+        } catch (Exception failure) {
+            throw new IllegalStateException("SHA256_UNAVAILABLE");
+        }
+    }
+
+    private static BusinessException denied(ErrorCode code, String message) {
+        return new BusinessException(code, message);
+    }
+
+    /**
+     * @author heyu
+     */
+    public record IdentityView(
+            String applicationId, String projectId, String subject, List<String> permissions) {}
+
+    /**
+     * @author heyu
+     */
+    public record DelegationView(String delegationId, String expiresAt, IdentityView identity) {}
+
+    /**
+     * @author heyu
+     */
+    public record TokenView(String authorization, String expiresAt) {}
+
+    /**
+     * @author heyu
+     */
+    private record Grant(String role, String permissions) {}
+
+    /**
+     * @author heyu
+     */
+    private record Delegation(
+            String id,
+            String application,
+            String project,
+            long user,
+            String run,
+            String roles,
+            String permissions,
+            long expiresAt,
+            boolean revoked) {}
+}
diff --git a/ops-auth-service/src/main/resources/harness-identity-schema.sql b/ops-auth-service/src/main/resources/harness-identity-schema.sql
new file mode 100644
--- /dev/null
+++ b/ops-auth-service/src/main/resources/harness-identity-schema.sql
@@ -0,0 +1,27 @@
+-- Explicit migration for the optional Harness bridge. No user or credential seed data.
+CREATE TABLE IF NOT EXISTS ops_harness_application (
+  application_id VARCHAR(64) PRIMARY KEY,
+  credential_hash CHAR(64) NOT NULL UNIQUE,
+  enabled INT NOT NULL DEFAULT 0
+);
+CREATE TABLE IF NOT EXISTS ops_harness_grant (
+  application_id VARCHAR(64) NOT NULL,
+  project_id VARCHAR(64) NOT NULL,
+  user_id BIGINT NOT NULL,
+  required_role VARCHAR(64) NOT NULL,
+  permissions_json TEXT NOT NULL,
+  enabled INT NOT NULL DEFAULT 0,
+  PRIMARY KEY (application_id, project_id, user_id)
+);
+CREATE TABLE IF NOT EXISTS ops_harness_delegation (
+  id VARCHAR(36) PRIMARY KEY,
+  application_id VARCHAR(64) NOT NULL,
+  project_id VARCHAR(64) NOT NULL,
+  user_id BIGINT NOT NULL,
+  run_id VARCHAR(128) NOT NULL,
+  roles_json TEXT NOT NULL,
+  permissions_json TEXT NOT NULL,
+  expires_at BIGINT NOT NULL,
+  revoked INT NOT NULL DEFAULT 0,
+  UNIQUE (application_id, run_id)
+);
diff --git a/ops-auth-service/src/test/java/com/opsagent/auth/HarnessIdentityServiceTest.java b/ops-auth-service/src/test/java/com/opsagent/auth/HarnessIdentityServiceTest.java
new file mode 100644
--- /dev/null
+++ b/ops-auth-service/src/test/java/com/opsagent/auth/HarnessIdentityServiceTest.java
@@ -0,0 +1,199 @@
+package com.opsagent.auth;
+
+import static org.assertj.core.api.Assertions.*;
+import static org.mockito.Mockito.*;
+
+import com.opsagent.common.security.InternalActorTokens;
+import com.opsagent.common.security.JwtProperties;
+import com.opsagent.common.security.JwtService;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.core.io.ClassPathResource;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.jdbc.datasource.DriverManagerDataSource;
+import org.springframework.jdbc.datasource.init.ResourceDatabasePopulator;
+
+import java.time.Instant;
+import java.util.List;
+import java.util.UUID;
+
+/**
+ * Durable delegation binds trusted application, project, user and run with current revocation
+ * checks.
+ *
+ * @author heyu
+ * @since 2026/9/3
+ */
+class HarnessIdentityServiceTest {
+    private static final String APP = "synthetic-application-secret-at-least-thirty-two-characters";
+    private static final String INTERNAL =
+            "synthetic-internal-signing-key-at-least-thirty-two-characters";
+    private JdbcTemplate jdbc;
+    private AuthService auth;
+    private JwtService jwt;
+    private HarnessIdentityService service;
+    private String login;
+
+    @BeforeEach
+    void setUp() {
+        var ds =
+                new DriverManagerDataSource(
+                        "jdbc:h2:mem:identity-"
+                                + UUID.randomUUID()
+                                + ";MODE=MySQL;DB_CLOSE_DELAY=-1",
+                        "sa",
+                        "");
+        new ResourceDatabasePopulator(new ClassPathResource("harness-identity-schema.sql"))
+                .execute(ds);
+        jdbc = new JdbcTemplate(ds);
+        jdbc.update(
+                "INSERT INTO ops_harness_application VALUES(?,?,1)",
+                "pilot-app",
+                HarnessIdentityService.sha256(APP));
+        jdbc.update(
+                "INSERT INTO ops_harness_grant VALUES(?,?,?,'USER',?,1)",
+                "pilot-app",
+                "ops-dev",
+                10,
+                "[\"runs:create\",\"runs:read\",\"opsagent:rag:search\"]");
+        auth = mock(AuthService.class);
+        active(List.of("USER"));
+        JwtProperties properties = new JwtProperties();
+        properties.setSecret("synthetic-existing-login-signing-secret-at-least-thirty-two");
+        jwt = new JwtService(properties);
+        login = jwt.issue(10, "synthetic-user", List.of("USER")).token();
+        service = new HarnessIdentityService(jdbc, auth, jwt, INTERNAL);
+    }
+
+    @Test
+    void existingLoginAndExplicitDatabaseGrantRequired() {
+        var identity = service.introspect("Bearer " + APP, "ops-dev", login);
+        assertThat(identity.subject()).isEqualTo("10");
+        assertThat(identity.applicationId()).isEqualTo("pilot-app");
+        assertThatThrownBy(() -> service.introspect("Bearer wrong", "ops-dev", login))
+                .hasMessageContaining("APPLICATION");
+        assertThatThrownBy(() -> service.introspect("Bearer " + APP, "other", login))
+                .hasMessageContaining("GRANT_DENIED");
+        assertThatThrownBy(() -> service.introspect("Bearer " + APP, "ops-dev", "forged"))
+                .hasMessageContaining("USER_TOKEN_INVALID");
+    }
+
+    @Test
+    void delegationSurvivesObjectReconstructionWithoutPersistedCredential() {
+        Instant deadline = Instant.now().plusSeconds(600);
+        var first = service.delegate("Bearer " + APP, "ops-dev", login, "run-one", deadline);
+        service = new HarnessIdentityService(jdbc, auth, jwt, INTERNAL);
+        var replay = service.delegate("Bearer " + APP, "ops-dev", login, "run-one", deadline);
+        assertThat(replay.delegationId()).isEqualTo(first.delegationId());
+        String stored = jdbc.queryForList("SELECT * FROM ops_harness_delegation").toString();
+        assertThat(stored).doesNotContain(login, APP, INTERNAL);
+        var minted = service.token("Bearer " + APP, first.delegationId(), "run-one", "rag");
+        var actor = new InternalActorTokens(INTERNAL).verify(minted.authorization(), "rag");
+        assertThat(actor.userId()).isEqualTo(10);
+        assertThat(actor.runId()).isEqualTo("run-one");
+        assertThat(actor.roles()).containsExactly("USER");
+        assertThat(
+                        jdbc.queryForObject(
+                                "SELECT COUNT(*) FROM ops_harness_delegation", Integer.class))
+                .isEqualTo(1);
+    }
+
+    @Test
+    void runBindingCannotBeRetargetedOrUsedByAnotherApplication() {
+        Instant deadline = Instant.now().plusSeconds(600);
+        var bound = service.delegate("Bearer " + APP, "ops-dev", login, "run-one", deadline);
+        assertThatThrownBy(
+                        () ->
+                                service.token(
+                                        "Bearer " + APP, bound.delegationId(), "run-other", "rag"))
+                .hasMessageContaining("NOT_FOUND");
+        assertThatThrownBy(
+                        () ->
+                                service.token(
+                                        "Bearer " + APP, bound.delegationId(), "run-one", "auth"))
+                .hasMessageContaining("AUDIENCE");
+        assertThatThrownBy(
+                        () ->
+                                service.delegate(
+                                        "Bearer " + APP,
+                                        "ops-dev",
+                                        login,
+                                        "run-one",
+                                        deadline.plusSeconds(5)))
+                .hasMessageContaining("CONFLICT");
+        String other = "another-synthetic-application-credential-at-least-thirty-two";
+        jdbc.update(
+                "INSERT INTO ops_harness_application VALUES(?,?,1)",
+                "other",
+                HarnessIdentityService.sha256(other));
+        assertThatThrownBy(
+                        () -> service.current("Bearer " + other, bound.delegationId(), "run-one"))
+                .hasMessageContaining("NOT_FOUND");
+    }
+
+    @Test
+    void roleAndPermissionElevationCannotExpandExistingDelegation() {
+        var bound =
+                service.delegate(
+                        "Bearer " + APP,
+                        "ops-dev",
+                        login,
+                        "run-one",
+                        Instant.now().plusSeconds(600));
+        active(List.of("USER", "ADMIN"));
+        jdbc.update(
+                "UPDATE ops_harness_grant SET permissions_json=?",
+                "[\"runs:create\",\"runs:read\",\"runs:admin\",\"opsagent:rag:search\"]");
+        assertThat(service.current("Bearer " + APP, bound.delegationId(), "run-one").permissions())
+                .doesNotContain("runs:admin");
+        var actor =
+                new InternalActorTokens(INTERNAL)
+                        .verify(
+                                service.token(
+                                                "Bearer " + APP,
+                                                bound.delegationId(),
+                                                "run-one",
+                                                "rag")
+                                        .authorization(),
+                                "rag");
+        assertThat(actor.roles()).containsExactly("USER");
+        jdbc.update("UPDATE ops_harness_grant SET permissions_json='[\"runs:read\"]'");
+        assertThat(service.current("Bearer " + APP, bound.delegationId(), "run-one").permissions())
+                .containsExactly("runs:read");
+        assertThatThrownBy(
+                        () ->
+                                service.token(
+                                        "Bearer " + APP, bound.delegationId(), "run-one", "rag"))
+                .hasMessageContaining("RETRIEVAL_DENIED");
+    }
+
+    @Test
+    void currentUserRoleGrantAndDelegationRevocationFailClosed() {
+        var bound =
+                service.delegate(
+                        "Bearer " + APP,
+                        "ops-dev",
+                        login,
+                        "run-one",
+                        Instant.now().plusSeconds(600));
+        active(List.of("AUDITOR"));
+        assertThatThrownBy(() -> service.current("Bearer " + APP, bound.delegationId(), "run-one"))
+                .hasMessageContaining("ROLES_REVOKED");
+        active(List.of("USER"));
+        jdbc.update("UPDATE ops_harness_grant SET enabled=0");
+        assertThatThrownBy(() -> service.current("Bearer " + APP, bound.delegationId(), "run-one"))
+                .hasMessageContaining("GRANT_DENIED");
+        jdbc.update("UPDATE ops_harness_grant SET enabled=1");
+        jdbc.update("UPDATE ops_harness_delegation SET revoked=1");
+        assertThatThrownBy(() -> service.current("Bearer " + APP, bound.delegationId(), "run-one"))
+                .hasMessageContaining("EXPIRED_OR_REVOKED");
+    }
+
+    private void active(List<String> roles) {
+        when(auth.actor(10))
+                .thenReturn(
+                        new AuthService.ActorView(
+                                true, 10, "synthetic-user", roles, null, null, null));
+    }
+}
