# Reference variable names for host-side HeaderProvider/ModelProfile configuration.
# This library DOES NOT automatically load .env files; the host supplies configuration.
# Offline examples do not use these settings and require no secrets.
DEEPSEEK_API_KEY=
HARNESS_MODEL_NAME=
HARNESS_MODEL_ENDPOINT=https://api.deepseek.com/chat/completions
# The live model probe is exactly model -> local echo -> model (2 model calls).
# This is a fixed protocol check, not an account-wide spending budget.
HARNESS_MODEL_CALL_LIMIT=2
HARNESS_MODEL_MAX_OUTPUT_TOKENS=128
# Official GitHub MCP: restrict discovery and invocation to the read-only repos toolset.
HARNESS_MCP_ENDPOINT=https://api.githubcopilot.com/mcp/x/repos/readonly
HARNESS_MCP_AUTH=bearer
HARNESS_MCP_TOKEN=
HARNESS_MCP_READ_TOOL=get_file_contents
# Use an absolute path when launching Maven from another directory.
HARNESS_MCP_ARGUMENTS_FILE=harness-validation/github-read-arguments.json
# Explicit live MySQL validation only accepts a pre-created harness_validation_* schema.
HARNESS_MYSQL_HOST=127.0.0.1
HARNESS_MYSQL_PORT=3306
HARNESS_MYSQL_DATABASE=harness_validation_dev
HARNESS_MYSQL_USER=
HARNESS_MYSQL_PASSWORD=
# DISABLED is allowed only for localhost/127.0.0.1. Remote hosts require VERIFY_IDENTITY.
HARNESS_MYSQL_TLS_MODE=DISABLED
# Use a dedicated development schema, never an existing business schema implicitly.
# Generic host integration names below are not used by the validation CLI.
HARNESS_JDBC_URL=
HARNESS_JDBC_USERNAME=
HARNESS_JDBC_PASSWORD=
