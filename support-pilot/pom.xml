<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>io.github.djyking</groupId><artifactId>agent-ai-platform</artifactId><version>0.1.0-SNAPSHOT</version></parent>
  <artifactId>support-pilot</artifactId>
  <name>Independent Customer Support Pilot</name>
  <dependencies>
    <dependency><groupId>io.github.djyking</groupId><artifactId>harness-platform-client</artifactId><version>${project.version}</version></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build><plugins><plugin>
    <groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.6.1</version>
    <executions><execution><phase>package</phase><goals><goal>shade</goal></goals><configuration>
      <createDependencyReducedPom>false</createDependencyReducedPom>
      <transformers><transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer"><mainClass>io.github.djyking.harness.support.SupportPilot</mainClass></transformer></transformers>
    </configuration></execution></executions>
  </plugin></plugins></build>
</project>
