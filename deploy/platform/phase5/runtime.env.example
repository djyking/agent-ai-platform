# Copy into private/runtime.env, chmod 0600; never commit real values.
HARNESS_JDBC_URL=jdbc:mysql://DATABASE_HOST:3306/harness_platform?useSSL=true&requireSSL=true&verifyServerCertificate=true&serverTimezone=UTC
HARNESS_JDBC_USER=harness_runtime
HARNESS_JDBC_PASSWORD=REPLACE_WITH_PRIVATE_PASSWORD
HARNESS_GOVERNANCE_CONFIG=/run/harness/governance.json
HARNESS_SIGNING_KEY=REPLACE_WITH_EXISTING_SIGNING_KEY
HARNESS_CONSOLE_CREDENTIAL=REPLACE_WITH_EXISTING_APP_CREDENTIAL
HARNESS_METRICS_TOKEN=REPLACE_WITH_32_OR_MORE_RANDOM_CHARACTERS
HARNESS_RETENTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY_DISTINCT_FROM_SIGNING
DEEPSEEK_API_KEY=REPLACE_WITH_EXISTING_AUTHORIZED_KEY
# Add only actual configured model credentials and existing identity delegation settings.
