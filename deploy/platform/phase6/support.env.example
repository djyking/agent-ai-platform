# Install as /etc/harness/support.env, mode 0600; never commit actual values.
SUPPORT_AUTH_MODE=opsagent
SUPPORT_RUNTIME_MODE=staging
SUPPORT_PORT=8098
SUPPORT_BIND_ADDRESS=127.0.0.1
# Private Docker network only: explicitly set 0.0.0.0; do not publish the BFF host port.
SUPPORT_PUBLIC_ORIGIN=https://support.example.invalid
SUPPORT_PLATFORM_ORIGIN=https://platform.example.invalid
SUPPORT_IDENTITY_ORIGIN=https://identity.example.invalid
SUPPORT_PROJECT=support-dev
SUPPORT_APPLICATION_SECRET=REPLACE_WITH_OFFLINE_PROVISIONED_APPLICATION_CREDENTIAL
